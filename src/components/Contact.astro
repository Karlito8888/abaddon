---
import { Image } from "astro:assets";
import whatsappIcon from "../assets/images/whatsapp.png";
import viberIcon from "../assets/images/viber.png";
import facebookIcon from "../assets/images/facebook.png";
import tiktokIcon from "../assets/images/tiktok.png";
import { ADDRESS, EMAIL, FACEBOOK_URL, MAPS_URL, PHONES, TIKTOK_URL, telHref, viberHref, whatsappHref } from "../site";
import "./Contact.css";

const messengers = [
  { label: "WhatsApp", icon: whatsappIcon, href: whatsappHref },
  { label: "Viber", icon: viberIcon, href: viberHref },
];
---

<section id="contact" class="contact section">
  <div class="container">
    <h2 class="section-title text-center" data-animate="reveal">Contact Us</h2>
    <p class="contact__intro text-center">Get your <strong>FREE pest inspection</strong> today !</p>
    <div class="contact__grid">
      <div class="contact__info" data-animate="reveal">
        <h3>Contact Information</h3>
        <div class="contact__address">
          <h4>📍 Business Address</h4>
          <p><strong>{ADDRESS.street}</strong></p>
          <p>{ADDRESS.locality}, {ADDRESS.region} {ADDRESS.postalCode}, Philippines</p>
          <p>
            <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              📍 View on Google Maps
            </a>
          </p>
        </div>
        <div class="contact__phone">
          <h4>📞 Call or Text</h4>
          {
            PHONES.map((phone, i) => (
              <p>
                <strong>Mobile {i + 1}:</strong> <a href={telHref(phone.e164)}>{phone.display}</a>
              </p>
            ))
          }
        </div>
        <div class="contact__digital">
          <h4>💬 Digital Contact</h4>
          {
            messengers.map(({ label, icon, href }) =>
              PHONES.map((phone, i) => (
                <p>
                  <strong>{label} {i + 1}:</strong>{" "}
                  <a href={href(phone.e164)} target="_blank" rel="noopener noreferrer" class="contact__social-link">
                    <Image src={icon} alt={label} class="contact__social-icon" width={48} height={48} />
                    <span>{phone.display}</span>
                  </a>
                </p>
              )),
            )
          }
          <p>
            <strong>Email:</strong> <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </p>
        </div>
        <div class="contact__social-links">
          <h4>🌐 Follow Us</h4>
          <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" class="contact__social-link">
            <Image src={facebookIcon} alt="Facebook" class="contact__social-icon" width={48} height={48} />
            <span>@Abaddon</span>
          </a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" class="contact__social-link">
            <Image src={tiktokIcon} alt="TikTok" class="contact__social-icon" width={48} height={48} />
            <span>@abaddon_2020</span>
          </a>
        </div>
        <div class="contact__service-areas">
          <h4>🗺️ Service Areas</h4>
          <p><strong>Primary:</strong> Salitran, Dasmariñas, Cavite</p>
          <p><strong>Metro Manila:</strong> Muntinlupa, Parañaque, Las Piñas</p>
          <p><strong>Coverage:</strong> Residential &amp; Commercial</p>
        </div>
      </div>
    </div>
  </div>
</section>
