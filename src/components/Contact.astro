---
import { Image } from "astro:assets";
import whatsappIcon from "../assets/images/whatsapp.png";
import viberIcon from "../assets/images/viber.png";
import facebookIcon from "../assets/images/facebook.png";
import tiktokIcon from "../assets/images/tiktok.png";
import { ADDRESS, EMAIL, FACEBOOK_URL, MAPS_URL, PHONES, TIKTOK_URL, telHref, viberHref, whatsappHref } from "../site";
import "./Contact.css";

const [main, second] = PHONES;
const areas = ["Dasmariñas, Cavite", "Muntinlupa", "Parañaque", "Las Piñas", "Residential & commercial"];

/** One tile per way to reach the company. `icon` is a brand image or an emoji glyph. */
const tiles: { label: string; value: string; href: string; icon: ImageMetadata | string; external?: boolean }[] = [
  { label: "Call or text", value: main.display, href: telHref(main.e164), icon: "📞" },
  { label: "Call or text", value: second.display, href: telHref(second.e164), icon: "📞" },
  { label: "WhatsApp", value: main.display, href: whatsappHref(main.e164), icon: whatsappIcon, external: true },
  { label: "Viber", value: main.display, href: viberHref(main.e164), icon: viberIcon },
  { label: "Email", value: EMAIL, href: `mailto:${EMAIL}`, icon: "✉️" },
  { label: "Visit us", value: `${ADDRESS.street}, ${ADDRESS.locality}`, href: MAPS_URL, icon: "📍", external: true },
  { label: "Facebook", value: "@Abaddon", href: FACEBOOK_URL, icon: facebookIcon, external: true },
  { label: "TikTok", value: "@abaddon_2020", href: TIKTOK_URL, icon: tiktokIcon, external: true },
];
---

<section id="contact" class="contact section">
  <div class="container contact__layout">
    <div class="contact__pitch" data-animate="reveal">
      <p class="contact__eyebrow">Free inspection</p>
      <h2 class="contact__title">Pests at home? Let's talk today.</h2>
      <p class="contact__lead">
        Call, text or message us. We answer every day from 8:00 to 18:00 and come to you across Dasmariñas,
        Muntinlupa, Parañaque and Las Piñas.
      </p>
      <div class="contact__cta">
        <a href={telHref(main.e164)} class="btn btn-primary">Call {main.display}</a>
        <a href={whatsappHref(main.e164)} class="btn contact__btn-ghost" target="_blank" rel="noopener noreferrer">
          Message on WhatsApp
        </a>
      </div>
      <ul class="contact__areas" aria-label="Service areas">
        {areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div class="contact__channels">
      {
        tiles.map((tile, i) => (
          <a
            href={tile.href}
            class="contact__tile"
            data-animate="reveal-stagger"
            data-delay={i % 4}
            target={tile.external ? "_blank" : undefined}
            rel={tile.external ? "noopener noreferrer" : undefined}
          >
            {typeof tile.icon === "string" ? (
              <span class="contact__tile-icon" aria-hidden="true">{tile.icon}</span>
            ) : (
              <Image src={tile.icon} alt="" class="contact__tile-icon" width={40} height={40} />
            )}
            <span class="contact__tile-text">
              <span class="contact__tile-label">{tile.label}</span>
              <span class="contact__tile-value">{tile.value}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
