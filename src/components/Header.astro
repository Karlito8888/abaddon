---
import { Image } from "astro:assets";
import logo from "../assets/logo/abaddon-logo-opt.png";
import { NAV_LINKS } from "../site";
import "./Header.css";
---

<header class="header">
  <div class="container header__container">
    <a href="#hero">
      <Image
        src={logo}
        alt="Abaddon Pest Control Logo"
        class="header__logo"
        width={37}
        height={50}
        densities={[1, 2, 3]}
        loading="eager"
      />
    </a>

    <nav class="header__nav" id="header-nav">
      <ul>
        {NAV_LINKS.map((link) => <li><a href={link.href}>{link.name}</a></li>)}
      </ul>
    </nav>

    <a href="#contact" class="btn btn-primary header__cta--desktop">FREE Inspection</a>

    <button class="header__hamburger" aria-label="Menu de navigation" aria-expanded="false" aria-controls="header-nav">
      <span class="header__hamburger-line"></span>
      <span class="header__hamburger-line"></span>
      <span class="header__hamburger-line"></span>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".header__hamburger")!;
  const nav = document.querySelector(".header__nav")!;
  button.addEventListener("click", () => {
    const open = nav.classList.toggle("header__nav--open");
    button.setAttribute("aria-expanded", String(open));
  });
</script>
